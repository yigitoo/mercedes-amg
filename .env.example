# ─────────────────────────────────────────────────────────────────────────────
#  AMG Pulse ortam değişkenleri
#  Yerel: bu dosyayı .env.local olarak kopyalayın (./mercedesctl setup otomatik yapar).
#  Vercel: Project > Settings > Environment Variables'a aynı adlarla ekleyin.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB bağlantısı (Atlas: Connect > Drivers). Boş bırakılırsa veriler bellekte tutulur:
# yerel denemede iş görür, Vercel'de KALICI DEĞİLDİR. Etkinlikte mutlaka dolu olmalı.
MONGODB_URI=
# Veritabanı adı.
MONGODB_DB=amg_pulse

# Admin paneli ekip şifresi. Üretimde zorunlu; yerelde boşsa "amg-demo".
ADMIN_PASSWORD=

# Bilekliklerin X-Device-Key başlığında gönderdiği anahtar. Üretimde zorunlu; yerelde boşsa "dev-device-key".
# Üretmek için: openssl rand -hex 24
INGEST_KEY=

# Nerede çalışıyor: vercel | node. Canlı ekranın WebSocket'ini kimin sunacağını belirler.
#   vercel: Vercel Functions WebSocket (src/app/api/ws/route.ts)
#   node:   düz Node sunucusu (server.mts: pnpm dev / pnpm start, deploy/ Docker)
# Boş: otomatik (Vercel'de vercel, başka her yerde node). İkisinde de ekran gerekirse SSE yedeğine geçer.
DEPLOY_TARGET=

# true ise ilk açılışta boş filoya örnek sürücüler atanır (deneme/sunum). Etkinlikte false.
DEMO_SEED=false
