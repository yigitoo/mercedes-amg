# deploy/.env olarak kopyalayın. Bu dosya hem docker compose hem uygulama tarafından okunur.

# Ekranın açılacağı alan adı (DNS A kaydı bu sunucunun IP'sini göstermeli). Caddy sertifikayı otomatik alır.
DOMAIN=pulse.example.com

# MongoDB bağlantısı. Atlas kullanıyorsanız Network Access'e bu sunucunun IP'sini ekleyin.
MONGODB_URI=
MONGODB_DB=amg_pulse

# Admin paneli şifresi (zorunlu).
ADMIN_PASSWORD=

# Bilekliklerin X-Device-Key anahtarı (zorunlu). Üretmek için: openssl rand -hex 24
INGEST_KEY=

DEMO_SEED=false

# Düz Node altyapısı (server.mts). Bu kurulumda hep node.
DEPLOY_TARGET=node
